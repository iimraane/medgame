{
    "name": "med-game",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node scripts/verify-dist.mjs",
        "test": "node --test tests/*.test.js",
        "preview": "vite preview",
        "worker:dev": "npm run build && wrangler dev",
        "deploy": "npm run build && wrangler deploy",
        "server": "npm run build && node server/server.js",
        "start": "concurrently \"npm run server\" \"npm run dev\""
    },
    "dependencies": {
        "@faker-js/faker": "^9.4.0",
        "concurrently": "^9.1.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "openai": "^4.52.3",
        "three": "0.180.0"
    },
    "devDependencies": {
        "vite": "^6.1.0",
        "wrangler": "^4.0.0"
    }
}
